{
  "name": "xahau-network-generator",
  "version": "0.1.0",
  "description": "Generate and run disposable Xahau testnet and standalone networks via Docker Compose",
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "bin": {
    "xng": "bin/xng.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tequdev/xahau-network-generator.git"
  },
  "keywords": ["xahau", "xrpl", "testnet", "docker"],
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "assets",
    "site",
    "traefik",
    "faucet",
    "debugstream",
    "docs",
    "xng.example.yml"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "xng": "tsx src/cli.ts",
    "e2e": "tsx e2e/check.ts",
    "e2e:apply": "tsx e2e/apply.ts",
    "e2e:restart": "tsx e2e/restart.ts",
    "e2e:cf": "tsx e2e/cloudflare.ts",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "commander": "^15.0.0",
    "xahau-address-codec": "^5.0.0",
    "xahau-binary-codec": "^2.3.0",
    "xahau-keypairs": "^2.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
